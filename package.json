{
  "name": "maxfit-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Full-Stack D2C Clothing E-Commerce with AI Virtual Try-On (MAXFIT)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "build": "npm --prefix client run build",
    "seed": "npm --prefix server run seed:mens",
    "seed:mens": "npm --prefix server run seed:mens",
    "reset:catalog": "npm --prefix server run reset:catalog",
    "test:vton": "npm --prefix server run test:vton",
    "test": "npm --prefix server run test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
